# Copy to .env and adjust for your environment.

# PostgreSQL connection string. The docker-compose.yml service matches these defaults.
DATABASE_URL="postgresql://lifeos:lifeos_dev_password@localhost:5432/lifeos?schema=public"

# Auth.js session encryption secret. Generate one with:
#   openssl rand -base64 32
# (the unrelated npm package literally named "auth" is a different tool —
# don't run `npx auth secret` expecting this)
AUTH_SECRET="replace-with-a-generated-secret"

# Base URL of the deployed app (used for auth callback URLs). Auth.js v5
# reads either name; both are set to the same value in production here.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Set to "true" to seed/allow the one-click demo account (see prisma/seed.ts).
LIFEOS_ENABLE_DEMO="true"
